# Required. Your MQTT broker, not the Zigbee2MQTT frontend.
# Supports mqtt://, mqtts://, ws:// and wss://
Z2M_MQTT_URL=mqtt://192.168.1.10:1883

# Optional broker credentials.
Z2M_MQTT_USERNAME=
Z2M_MQTT_PASSWORD=

# Must match mqtt.base_topic in your Zigbee2MQTT configuration.yaml
Z2M_BASE_TOPIC=zigbee2mqtt

# off  = read-only tools only
# safe = read plus non-destructive writes (permit_join, options, rename, bind)
# full = everything, including device removal, OTA flashing and bridge restart
Z2M_WRITE_MODE=full

# silent | error | warn | info | debug  (written to stderr)
Z2M_LOG_LEVEL=error

# Thresholds used by z2m_health_report and z2m_list_devices(only_problems)
Z2M_WEAK_LINK_THRESHOLD=30
Z2M_LOW_BATTERY_THRESHOLD=20
Z2M_STALE_HOURS=24

# Timeouts in milliseconds
Z2M_CONNECT_TIMEOUT_MS=10000
Z2M_REQUEST_TIMEOUT_MS=15000

# TLS, for mqtts:// brokers
Z2M_MQTT_REJECT_UNAUTHORIZED=true
Z2M_MQTT_CA=
Z2M_MQTT_CERT=
Z2M_MQTT_KEY=
