    "zigbee2mqtt",
    "zigbee",
    "mqtt",
    "smart-home",
    "home-automation",
    "iot"
  ],
  "license": "MIT",
  "author": "Alex Pfau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpfau/zigbee2mqtt-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alexpfau/zigbee2mqtt-mcp/issues"
  },
  "homepage": "https://github.com/alexpfau/zigbee2mqtt-mcp#readme",
  "type": "module",
  "bin": {
    "zigbee2mqtt-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
